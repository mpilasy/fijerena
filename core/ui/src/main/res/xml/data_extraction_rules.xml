<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device through Android backup: not to the cloud, not in a device-to-device
    transfer (which Android 12+ still runs with allowBackup="false"). The app's files hold the
    encrypted credential store (provider passwords, the live sync account key) and the databases
    (sources, guide sources, favourites, watch history). Moving to a new device goes through
    Settings → Export / Import or live sync instead.
    See docs/plans/20261011_public-release-fdroid-readiness-plan.md → P1, data extraction rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
