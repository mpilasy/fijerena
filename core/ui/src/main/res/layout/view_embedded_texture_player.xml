<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView backed by a TextureView (not the default SurfaceView). Used for the small embedded
  Live TV preview pane: a SurfaceView janks/blocks the main thread when a sibling list scrolls or
  recomposes next to it, causing ANRs. TextureView composites normally. surface_type can only be
  set at inflation, hence this layout.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never"
    app:resize_mode="fit" />
