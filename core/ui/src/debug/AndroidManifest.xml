<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: drives live sync over adb (see SyncDebugReceiver). -->
        <receiver
            android:name="org.njarasoa.fijerena.core.ui.sync.SyncDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.njarasoa.fijerena.DEBUG_SYNC" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
